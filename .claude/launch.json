{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "spike-http",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "spikes/vr-camera-feel",
        "dev:http"
      ],
      "port": 5173
    },
    {
      "name": "spike-https",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "spikes/vr-camera-feel",
        "dev"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    }
  ]
}
